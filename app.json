{
  "expo": {
    "name": "vasilena-markova-yoga-vibe",
    "slug": "vasilena-markova-yoga-vibe",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo-yoga-app.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-yoga-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#9B59B6"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.vasilenamarkova.yogavibe",
      "versionCode": 3,
    "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-yoga-app.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-yoga-app.png",
          "color": "#9B59B6",
          "sounds": []
        }
      ]
    ],
    "web": {
      "favicon": "./assets/logo-yoga-app.png"
    },
    "extra": {
      "eas": {
        "projectId": "8a8ad70c-5d3b-4a2d-b95c-1b85043aed91"
      }
    },
    "owner": "almishev"
  }
}
